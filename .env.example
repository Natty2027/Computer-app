# Cognivate web app — environment variables
# Copy this file to `.env` and fill in as needed. Vite only exposes vars
# prefixed with VITE_ to the client bundle.

# Auth toggle. Sign-in is DISABLED by default (preview mode) so the app loads
# without a Clerk login — useful while auth isn't wired for this domain.
# NOTE: the backend still requires a session, so account data (library,
# practice, tutor, etc.) will be empty/error in preview mode. To turn real
# sign-in back on, set this to "false" and provide VITE_CLERK_PUBLISHABLE_KEY.
VITE_DISABLE_AUTH=true

# Backend API origin. The generated API client calls "/api/..." against this.
# Defaults to the production API if unset.
VITE_API_BASE_URL=https://cognivate.co

# Clerk publishable key (public — safe to commit/ship). This is the production
# ("live") key for clerk.cognivate.co.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuY29nbml2YXRlLmNvJA

# Optional: Clerk proxy URL, only needed for custom-domain / satellite setups.
# VITE_CLERK_PROXY_URL=

# Optional: asset base path. Set to "/Computer-app/" if hosting under a
# GitHub Pages project subpath rather than a custom domain / root.
# BASE_PATH=/
